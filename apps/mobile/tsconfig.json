{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "paths": {
      "@frequencii/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "index.js",
    "polyfill.js",
    "../../packages/shared/src/**/*.ts"
  ]
}
